# Vercel / 로컬 공통 — .env.local 로 복사 후 값 입력

# Amazon Aurora PostgreSQL
AURORA_DB_URL=postgresql://postgres:[PASSWORD]@kbds-rds-finpm-db.cluster-c7koskw0kdf9.ap-northeast-2.rds.amazonaws.com:5432/pm_agent?sslmode=require

# Flask 세션 (Vercel 필수)
FLASK_SECRET_KEY=change-me-to-random-secret

# Bedrock — Vercel: IAM Access Key 또는 STS/MFA 임시 자격 증명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Vercel에 AWS_SECURITY_TOKEN 으로 넣은 경우에도 동일하게 읽음 (표준 이름은 SESSION_TOKEN)
# AWS_SECURITY_TOKEN=
AWS_REGION=ap-northeast-2
# 선택: Bedrock Runtime 리전 고정
AWS_BEDROCK_REGION=
# 기본: Claude Sonnet 4.5 (anthropic.claude-sonnet-4-5-20250929-v1:0)
# BEDROCK_MODEL_ID=
# BEDROCK_MODEL_ID_FALLBACK=anthropic.claude-sonnet-4-20250514-v1:0

# 요약 PDF → S3 저장 (요약 요청 시 pdf_url 반환)
CULTURE_S3_BUCKET=
CULTURE_S3_PREFIX=culture-summaries/
# CULTURE_S3_REGION=ap-northeast-2
# CULTURE_S3_PRESIGNED_EXPIRES=604800
# CULTURE_S3_PUBLIC=0
# 한글 PDF 폰트 (기본: culture/fonts/NotoSansKR-Regular.otf, 없으면 자동 다운로드)
# CULTURE_PDF_FONT=/path/to/custom.ttf
# CULTURE_FONT_CACHE_DIR=/tmp

# OpenSearch 스키마 벡터 (k-NN)
# OPENSEARCH_HOST=search-xxx.ap-northeast-2.es.amazonaws.com
# OPENSEARCH_INDEX=culture-schema-meta
# OPENSEARCH_REGION=ap-northeast-2
# OPENSEARCH_USE_IAM=1
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_EMBED_DIMENSION=1024
# SCHEMA_VECTOR_SCHEMAS=INST1,public
